# Copiez ce fichier en .env.local et complétez les valeurs.
# Ne jamais committer de vraies clés — ce fichier ne doit contenir que des exemples.

# --- Supabase (base de données, authentification, stockage) ---
# À utiliser au prochain lot, lors du branchement de Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anonyme-publique
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role-secrete

# --- Stripe (paiements) ---
# À utiliser au prochain lot, lors du branchement du paiement.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
