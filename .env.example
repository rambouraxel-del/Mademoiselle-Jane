# =====================================================================
# Mademoizelle Jane — variables d'environnement
# Copiez ce fichier en « .env.local » (local) ou saisissez ces valeurs
# dans Vercel (Settings → Environment Variables). Ne commitez JAMAIS
# de vraies clés : seuls les noms des variables figurent ici.
# Les variables préfixées NEXT_PUBLIC_ sont visibles par le navigateur :
# n'y mettez jamais de secret.
# =====================================================================

# --- Aperçu visuel (sans aucun service externe) -------------------------
# true : le site public s'affiche avec les données initiales locales
# (produits, textes, photos des maquettes). Paiement, formulaires et
# administration sont désactivés, le site n'est pas indexé.
# Toutes les autres variables peuvent alors rester vides.
# Ne JAMAIS activer sur la boutique réelle. Voir docs/APERCU-VERCEL.md.
PREVIEW_MODE=false

# Adresse publique du site, sans « / » final.
# Facultatif sur Vercel : l'adresse du projet est détectée automatiquement.
# Local : http://localhost:3000 — Production : https://www.votre-domaine.fr
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (base de données, connexion admin, photos) -------------
# Supabase → Project Settings → API Keys.
# En local, « npx supabase start » affiche ces valeurs.
NEXT_PUBLIC_SUPABASE_URL=
# Clé publique « publishable » (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé SECRÈTE (sb_secret_…) : serveur uniquement (commandes, webhooks, formulaires).
SUPABASE_SECRET_KEY=

# --- Stripe (paiement) ------------------------------------------------
# Commencez avec les clés de TEST (sk_test_…) : un bandeau « mode test » s'affiche.
# Stripe → Developers → API keys.
STRIPE_SECRET_KEY=
# Secret de signature du webhook (whsec_…) :
# Stripe → Developers → Webhooks → votre point de terminaison → « Signing secret ».
# En local : affiché par « stripe listen --forward-to localhost:3000/api/stripe/webhook ».
STRIPE_WEBHOOK_SECRET=
# Uniquement pour les tests automatisés avec stripe-mock. Laisser VIDE en production.
STRIPE_MOCK_URL=

# --- Emails transactionnels -------------------------------------------
# Prestataire : resend | smtp | none (aucun envoi)
EMAIL_PROVIDER=none
# Expéditeur affiché, sur un domaine vérifié chez le prestataire.
# Exemple : Mademoizelle Jane <commandes@votre-domaine.fr>
EMAIL_FROM=
# Adresse qui reçoit les nouvelles commandes et messages de contact.
SHOP_NOTIFICATION_EMAIL=
# Si EMAIL_PROVIDER=resend : clé API Resend (re_…)
RESEND_API_KEY=
# Si EMAIL_PROVIDER=smtp : paramètres du serveur SMTP (Brevo, OVH, Gmail…)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true pour le port 465 (SSL direct), false pour 587 (STARTTLS)
SMTP_SECURE=false

# --- Sécurité des formulaires -------------------------------------------
# Chaîne aléatoire d'au moins 32 caractères (obligatoire en production).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FORM_SECRET=

# --- Anti-robot Cloudflare Turnstile (facultatif) -----------------------
# Laisser vide pour ne pas l'activer (le formulaire reste protégé par
# champ piège, délai minimal et limitation des envois).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
